---
// Wordmark — the same ✦ spark + violet→cyan gradient word as logs.stellarresonance.app's `.nav-logo`
// ("StellarLogs") and the marketing site's brand ("StellarResonance").
---
<a href="/" class="nav-logo"><span class="spark" aria-hidden="true">✦</span><span class="word">StellarDocs</span></a>
<style>
  .nav-logo { display: flex; align-items: center; gap: 9px; font-family: var(--st-display); font-weight: 700; font-size: 1.18rem; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; }
  .nav-logo:hover { text-decoration: none; }
  .spark { font-size: 1.15rem; line-height: 1; color: var(--st-accent); text-shadow: 0 0 14px #7c5cff88; }
  .word { background: linear-gradient(92deg, #a48bff, var(--st-accent2)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
</style>
