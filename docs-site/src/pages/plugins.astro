---
// Plugin gallery — generated by scripts/gen-all.mjs (genPlugins) from the public plugin registry.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import plugins from '../generated/plugins.json';

// Only tags shared by 2+ plugins become filter chips (single-plugin tags are noise); search still matches all.
const tagCount = new Map<string, number>();
for (const t of plugins.flatMap((p) => p.tags)) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount].filter(([, n]) => n >= 2).map(([t]) => t).sort();
const apiSlug = (iface: string) => `/api/stellar-abstractions-services/${iface.toLowerCase()}/`;
const hue = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
const initials = (n: string) => n.replace(/([a-z])([A-Z])/g, '$1 $2').split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<StarlightPage
  frontmatter={{ title: 'Plugin gallery', description: 'Every plugin in the public Stellar registry, with its source and the framework APIs it uses.', tableOfContents: false, editUrl: 'https://github.com/StellarProtocol/StellarResonancePlugins' }}
>
  <p class="st-lede">
    Every plugin in the <a href="https://github.com/StellarProtocol/StellarResonancePlugins">public registry</a>, each
    built from a pinned commit of its own source repo. The fastest way to learn a pattern is to read a plugin that already
    does it — <b>APIs used</b> lists the <a href="/api/stellar-abstractions-services/ipluginservices/"><code>IPluginServices</code></a>
    members each one touches. <span class="st-generated">generated from the plugin registry</span>
  </p>

  <div class="pg-filters not-content" data-pg-filters>
    <button class="on" data-tag="">All <span>{plugins.length}</span></button>
    {tags.map((t) => <button data-tag={t}>{t}</button>)}
    <input type="search" placeholder="Filter by name or API… e.g. CombatEvents" aria-label="Filter plugins" data-pg-q />
  </div>

  <div class="pg-grid not-content">
    {plugins.map((p) => (
      <article class="pg-card" data-tags={p.tags.join(' ')} data-text={`${p.name} ${p.description} ${p.tags.join(' ')} ${p.apis.map((a) => a.prop + ' ' + a.iface).join(' ')}`.toLowerCase()}>
        {p.image
          ? <img src={p.image} alt={p.imageCaption ?? p.name} loading="lazy" />
          : <div class="pg-noimg" style={`--h:${hue(p.id)}`}>{initials(p.name)}</div>}
        <div class="pg-body">
          <div class="pg-top"><h3>{p.name}</h3><span class="pg-ver">v{p.version}</span></div>
          <p class="pg-desc">{p.description}</p>
          <div class="pg-meta">by {p.author}{p.minFramework && <> · needs framework ≥ {p.minFramework}</>}</div>
          <details class="pg-apis">
            <summary>APIs used <span>{p.apis.length}</span></summary>
            <div>{p.apis.map((a) => <a href={apiSlug(a.iface)} title={a.iface}><code>{a.prop}</code></a>)}</div>
          </details>
          <div class="pg-links">
            <a href={p.sourceAtCommit}>Source ↗</a>
            {p.homepage && <a href={p.homepage}>Homepage ↗</a>}
          </div>
        </div>
      </article>
    ))}
  </div>
</StarlightPage>

<script>
  const root = document.querySelector('[data-pg-filters]');
  const q = root?.querySelector<HTMLInputElement>('[data-pg-q]');
  let tag = '';
  function apply() {
    const text = (q?.value ?? '').trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('.pg-card').forEach((c) => {
      const okTag = !tag || (c.dataset.tags ?? '').split(' ').includes(tag);
      c.hidden = !(okTag && (!text || (c.dataset.text ?? '').includes(text)));
    });
  }
  root?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
    tag = b.dataset.tag ?? '';
    root.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    apply();
  }));
  q?.addEventListener('input', apply);
</script>

<style is:global>
  :root { --sl-content-width: 76rem; }
</style>

<style>
  .st-lede { font-size: 1.05rem; color: var(--sl-color-gray-2); }
  .pg-filters { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; margin: 1.25rem 0 1rem; }
  .pg-filters button { height: 1.9rem; padding: 0 0.75rem; border-radius: 999px; border: 1px solid var(--st-line); background: var(--st-panel); color: var(--st-muted); font-size: 0.8rem; cursor: pointer; }
  .pg-filters button span { font: 600 0.7rem var(--sl-font-mono); color: var(--st-dim); margin-left: 0.25rem; }
  .pg-filters button.on { border-color: rgba(124, 92, 255, 0.5); background: var(--st-acc-soft); color: #d8d2ff; }
  .pg-filters input { margin-left: auto; height: 2rem; width: 17rem; padding: 0 0.75rem; border-radius: 8px; border: 1px solid var(--st-line); background: var(--st-panel); color: var(--st-text); }
  .pg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1rem; }
  .pg-card { border: 1px solid var(--st-line); border-radius: 14px; background: var(--st-panel); overflow: hidden; display: flex; flex-direction: column; }
  .pg-card[hidden] { display: none; }
  .pg-card img, .pg-noimg { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; display: block; background: var(--st-bg2); border-bottom: 1px solid var(--st-line); }
  .pg-noimg { display: grid; place-items: center; font: 700 2rem var(--st-display); color: #fff; background: linear-gradient(135deg, hsl(var(--h) 60% 45%), hsl(calc(var(--h) + 40) 60% 25%)); }
  .pg-body { padding: 0.9rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .pg-top { display: flex; align-items: baseline; gap: 0.5rem; }
  .pg-top h3 { margin: 0; font: 600 1.05rem var(--st-display); color: var(--sl-color-white); }
  .pg-ver { margin-left: auto; font: 0.75rem var(--sl-font-mono); color: var(--st-dim); }
  .pg-desc { margin: 0; font-size: 0.87rem; color: var(--st-muted); }
  .pg-meta { font-size: 0.75rem; color: var(--st-dim); }
  .pg-apis summary { cursor: pointer; font-size: 0.8rem; color: var(--sl-color-text-accent); }
  .pg-apis summary span { font: 600 0.7rem var(--sl-font-mono); color: var(--st-dim); }
  .pg-apis div { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem; }
  .pg-apis code { font-size: 0.7rem; }
  .pg-links { display: flex; gap: 1rem; font-size: 0.85rem; margin-top: auto; padding-top: 0.3rem; }
</style>
