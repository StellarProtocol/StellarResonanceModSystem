---
// Wire coverage explorer — generated by scripts/gen-all.mjs (genWire) from the schemas the readers document
// + docs/wire/coverage.json. Filters are plain client-side JS; the page is fully readable without it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import wire from '../generated/wire.json';

const STATUS = {
  exposed: { label: 'Exposed', hint: 'plugins can use it' },
  internal: { label: 'Decoded', hint: 'read by the framework, not public yet' },
  skipped: { label: 'Skipped', hint: 'not decoded — open for contributions' },
  unclassified: { label: 'Unclassified', hint: 'missing from docs/wire/coverage.json' },
};
const t = wire.totals;
const headings = wire.messages.map((m) => ({ depth: 2, slug: m.message.toLowerCase(), text: m.message }));
const REPO = 'https://github.com/StellarProtocol/StellarResonanceModSystem';
---
<StarlightPage
  frontmatter={{ title: 'Wire coverage', description: 'Every server message field the framework reads — what plugins can use today, what is decoded internally, and what is still waiting for a contributor.', editUrl: `${REPO}/edit/main/docs/wire/coverage.json` }}
  headings={headings}
>
  <p class="st-lede">
    Every protobuf message a framework reader documents, field by field. <b>Exposed</b> fields reach plugins through
    the public API; <b>skipped</b> fields are sent by the server but not decoded yet — each one is an open contribution.
    <span class="st-generated">generated from reader sources</span>
  </p>

  <div class="wire-cards">
    <div class="wire-card"><span>Exposed to plugins</span><b class="c-exposed">{t.exposed}</b><small>of {t.fields} documented fields</small></div>
    <div class="wire-card"><span>Decoded, internal only</span><b class="c-internal">{t.internal}</b><small>read but not public yet</small></div>
    <div class="wire-card"><span>Skipped</span><b class="c-skipped">{t.skipped}</b><small>waiting for a contributor</small></div>
    {t.unclassified > 0 && <div class="wire-card"><span>Unclassified</span><b class="c-unclassified">{t.unclassified}</b><small>needs an entry in coverage.json</small></div>}
  </div>

  <div class="wire-filters not-content" data-wire-filters>
    <button class="on" data-f="all">All <span>{t.fields}</span></button>
    <button data-f="exposed">Exposed <span>{t.exposed}</span></button>
    <button data-f="internal">Decoded <span>{t.internal}</span></button>
    <button data-f="skipped">Skipped <span>{t.skipped}</span></button>
    {t.goodFirstIssue > 0 && <button data-f="gfi">★ Good first issue <span>{t.goodFirstIssue}</span></button>}
    <input type="search" placeholder="Filter fields… e.g. buff" aria-label="Filter fields" data-wire-q />
  </div>

  {wire.messages.map((m) => (
    <section class="wire-msg" data-msg={m.message}>
      <h2 id={m.message.toLowerCase()}>{m.message}</h2>
      <p class="wire-src">Documented in <a href={m.url}><code>{m.source.split('/').pop()}</code> ↗</a></p>
      <table>
        <thead><tr><th>#</th><th>Field</th><th>Type</th><th>Status</th><th>Plugins get it as</th></tr></thead>
        <tbody>
          {m.fields.map((f) => (
            <tr data-status={f.status} data-gfi={f.goodFirstIssue ? '1' : undefined} data-text={`${m.message} ${f.name} ${f.type} ${f.exposedAs ?? ''} ${f.note ?? ''}`.toLowerCase()} class:list={{ gfi: f.goodFirstIssue }}>
              <td class="num">{f.num}</td>
              <td><code>{f.name}</code></td>
              <td class="type">{f.type}</td>
              <td>
                <span class={`wchip s-${f.status}`} title={STATUS[f.status]?.hint}>{STATUS[f.status]?.label ?? f.status}</span>
                {f.since && <span class="wchip s-since">{f.since}</span>}
                {f.goodFirstIssue && <span class="wchip s-gfi">★ good first issue</span>}
              </td>
              <td>{f.exposedAs ?? <span class="dim">—</span>}{f.note && <div class="note">{f.note}</div>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <aside class="wire-how">
    <b>Want to expose a skipped field?</b> Follow <a href="/contribute/expose-a-wire-field/">Expose a wire field</a>, then
    update its entry in <a href={`${REPO}/blob/main/docs/wire/coverage.json`}><code>docs/wire/coverage.json</code></a>.
    The docs build fails if a documented field is missing from that file, so this page cannot silently go stale.
  </aside>
</StarlightPage>

<script>
  const root = document.querySelector('[data-wire-filters]');
  const q = root?.querySelector<HTMLInputElement>('[data-wire-q]');
  let filter = 'all';
  function apply() {
    const text = (q?.value ?? '').trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('.wire-msg').forEach((sec) => {
      let shown = 0;
      sec.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((tr) => {
        const okF = filter === 'all' || (filter === 'gfi' ? tr.dataset.gfi === '1' : tr.dataset.status === filter);
        const okT = !text || (tr.dataset.text ?? '').includes(text);
        tr.hidden = !(okF && okT);
        if (!tr.hidden) shown++;
      });
      sec.hidden = shown === 0;
    });
  }
  root?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.f ?? 'all';
    root.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    apply();
  }));
  q?.addEventListener('input', apply);
</script>

<style>
  .st-lede { font-size: 1.05rem; color: var(--sl-color-gray-2); }
  .wire-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem; margin: 1.25rem 0; }
  .wire-card { border: 1px solid var(--st-line); border-radius: 12px; background: var(--st-panel); padding: 0.85rem 1rem; display: flex; flex-direction: column; margin: 0; }
  .wire-card span { font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--st-dim); }
  .wire-card b { font: 700 1.75rem var(--st-display); }
  .wire-card small { color: var(--st-muted); font-size: 0.8rem; }
  .c-exposed { color: var(--st-ok); } .c-internal { color: var(--st-warn); } .c-skipped { color: var(--st-pink); } .c-unclassified { color: var(--st-dim); }
  .wire-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin: 1rem 0 0.5rem; position: sticky; top: calc(var(--sl-nav-height) + 0.25rem); z-index: 5; background: var(--st-bg); padding: 0.5rem 0; }
  .wire-filters button { height: 2rem; padding: 0 0.8rem; border-radius: 999px; border: 1px solid var(--st-line); background: var(--st-panel); color: var(--st-muted); font-size: 0.82rem; cursor: pointer; }
  .wire-filters button span { font: 600 0.7rem var(--sl-font-mono); color: var(--st-dim); margin-left: 0.25rem; }
  .wire-filters button.on { border-color: rgba(124, 92, 255, 0.5); background: var(--st-acc-soft); color: #d8d2ff; }
  .wire-filters input { margin-left: auto; height: 2rem; width: 15rem; padding: 0 0.75rem; border-radius: 8px; border: 1px solid var(--st-line); background: var(--st-panel); color: var(--st-text); }
  .wire-src { font-size: 0.82rem; color: var(--st-dim); margin-top: 0.25rem; }
  .wire-msg table td.num { font: 0.8rem var(--sl-font-mono); color: var(--st-dim); }
  .wire-msg table td.type { font: 0.8rem var(--sl-font-mono); color: var(--st-muted); }
  .wire-msg tr.gfi td { background: rgba(255, 123, 202, 0.05); }
  .wchip { display: inline-flex; font: 600 0.66rem/1 var(--sl-font); letter-spacing: 0.05em; text-transform: uppercase; padding: 0.3rem 0.5rem; border-radius: 999px; border: 1px solid; margin: 0 0.25rem 0.2rem 0; white-space: nowrap; }
  .s-exposed { color: var(--st-ok); border-color: rgba(70, 192, 138, 0.35); background: rgba(70, 192, 138, 0.1); }
  .s-internal { color: var(--st-warn); border-color: rgba(232, 196, 90, 0.35); background: rgba(232, 196, 90, 0.08); }
  .s-skipped, .s-unclassified { color: var(--st-dim); border-color: var(--st-line); background: var(--st-panel2); }
  .s-since { color: var(--st-ok); border-color: rgba(70, 192, 138, 0.35); }
  .s-gfi { color: var(--st-pink); border-color: rgba(255, 123, 202, 0.4); background: rgba(255, 123, 202, 0.08); }
  .dim { color: var(--st-dim); }
  .note { font-size: 0.8rem; color: var(--st-muted); margin-top: 0.2rem; }
  .wire-how { margin-top: 2rem; border: 1px solid rgba(124, 92, 255, 0.4); background: rgba(124, 92, 255, 0.08); border-radius: 10px; padding: 0.9rem 1.1rem; }
</style>
