{
  "//": "Wire coverage — one entry per field of every message schema documented in a reader XML doc comment. The docs build FAILS if a documented field is missing here or an entry names a field that no longer exists. status: exposed = plugins can use it (say how in exposedAs); internal = decoded but not public; skipped = not decoded.",
  "messages": {
    "AoiSyncToMeDelta": {
      "fields": {
        "1": {
          "name": "BaseDelta",
          "status": "exposed",
          "exposedAs": "the local player's attrs, skill events, damage and buffs, same path as the near-entity delta (see AttrCollection, EventDataList, SkillEffect)"
        },
        "2": {
          "name": "SyncHateIds",
          "status": "skipped"
        },
        "3": {
          "name": "SyncSkillCDs",
          "status": "exposed",
          "exposedAs": "ICombatSnapshot.LocalCooldowns"
        },
        "4": {
          "name": "FightResCDs",
          "status": "skipped"
        },
        "5": {
          "name": "Uuid",
          "status": "exposed",
          "exposedAs": "ICombatSnapshot.LocalEntityId"
        }
      }
    },
    "Attr": {
      "fields": {
        "1": {
          "name": "Id",
          "status": "exposed",
          "exposedAs": "CombatEvent.EntityAttributesChanged (AttrValue.AttrId); selects which ICombatLookup / IEntityDetail value an attr feeds"
        },
        "2": {
          "name": "RawData",
          "status": "exposed",
          "exposedAs": "CombatEvent.EntityAttributesChanged (AttrValue.Value), ICombatLookup.GetEntityName / GetVitals / GetTeamId / GetFightPoint / GetSkillLevels, IEntityDetail"
        }
      }
    },
    "AttrCollection": {
      "fields": {
        "1": {
          "name": "Uuid",
          "status": "internal",
          "note": "decoded but not read by any consumer; the entity id comes from the enclosing delta / entity uuid"
        },
        "2": {
          "name": "Attrs",
          "status": "exposed",
          "exposedAs": "see Attr"
        }
      }
    },
    "DisappearEntity": {
