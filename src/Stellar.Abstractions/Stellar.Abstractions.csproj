<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Stellar.Abstractions</RootNamespace>
    <AssemblyName>Stellar.Abstractions</AssemblyName>
    <Description>StellarResonance plugin API — the read-only contract surface plugins build against.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- NuGet package metadata (published as part of the plugin SDK — see
         docs/superpowers/plans/2026-06-18-per-plugin-repos-dip17-migration.md). -->
    <Authors>StellarProtocol</Authors>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/StellarProtocol/StellarResonanceModSystem</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StellarProtocol/StellarResonanceModSystem.git</RepositoryUrl>
  </PropertyGroup>
  <!-- Sole external reference: 0Harmony, because IHarmonyHost.Create returns HarmonyLib.Harmony (the plugin-facing
       patch-lifecycle contract). Bound to the committed API-only stub in refs/ (Private=false) so this layer still
       builds without a game install — the game provides the real 0Harmony at runtime, and plugins already carry it
       via the Stellar.Plugin.InteropRefs package. -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildThisFileDirectory)../../refs/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Test seam: PerfProbe/PerfControls expose internal override hooks so the
       env gate can be forced on/off in unit tests without a real env var. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Stellar.Application.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
